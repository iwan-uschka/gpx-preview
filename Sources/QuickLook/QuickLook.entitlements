<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox is required for Quick Look to register the extension.
         Quick Look grants read access to the previewed file. network.client
         lets MKMapSnapshotter reach Apple Maps (stage-1 probe). Never add the
         restricted com.apple.developer.maps entitlement: an ad-hoc-signed
         binary claiming it is killed at launch. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
